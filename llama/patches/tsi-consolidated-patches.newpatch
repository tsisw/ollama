+extern "C" void ggml_backend_log_profile_info(ggml_backend_t backend)
+{
+    if (backend == NULL) {
+        return;
+    }
+    if (backend->iface.profile == NULL) {
+       return;
+    }
+    backend->iface.profile();
+    return;
+}
